# Static form rendering remains disabled unless both values are explicitly changed.
SITE_ENV=local

# Cloudflare Web Analytics remains disabled unless this flag is explicitly true,
# SITE_ENV is production, and a token is supplied at build time.
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_ENABLED=false
PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=

# build:production fails if any of these three is set. build:staging accepts the
# live set only together (enabled=true, mode=live, site key); the staging deploy
# workflow supplies them from the staging GitHub Environment variable
# PUBLIC_TURNSTILE_SITE_KEY, never from this file.
PUBLIC_INQUIRY_FORM_ENABLED=false
PUBLIC_INQUIRY_FORM_MODE=off

# Public Turnstile site key. Required only when mode is "live".
PUBLIC_TURNSTILE_SITE_KEY=

# Blog draft preview. Only `npm run dev` honours it; every build ignores it, and
# build:staging / build:production remove it from the environment.
# PUBLIC_BLOG_PREVIEW_DRAFTS=true

# Local rendering test (never calls a public endpoint):
# PUBLIC_INQUIRY_FORM_ENABLED=true
# PUBLIC_INQUIRY_FORM_MODE=local-mock
