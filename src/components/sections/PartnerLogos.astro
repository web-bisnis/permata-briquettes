---
import { LAB_LOGOS } from "../../config/labs";
import { hasMedia } from "../../config/media";
import type { MediaLocale } from "../../config/media-slots";
import Media from "../Media.astro";
import Section from "./Section.astro";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  lang: MediaLocale;
  /** Heading id; change it when the section appears twice on one page. */
  id?: string;
}

const { lang, id = "lab-logos" } = Astro.props;
// The section is hidden until at least one logo file has been supplied.
const logos = LAB_LOGOS.filter((logo) => hasMedia(logo.mediaId));
const copy = lang === "id"
  ? {
      eyebrow: "Pihak ketiga",
      title: "Laboratorium dan surveyor",
      intro: "Lembaga pengujian dan inspeksi yang namanya dapat muncul pada dokumen mutu dan pengiriman.",
      note: "Logo adalah milik masing-masing lembaga dan ditampilkan sebagai penerbit dokumen, bukan sebagai sertifikasi atau dukungan terhadap Permata Briquettes. Penerbit, tanggal, dan cakupan tertera pada setiap dokumen.",
      list: "Logo laboratorium dan surveyor",
    }
  : {
      eyebrow: "Third parties",
      title: "Laboratories and surveyors",
      intro: "Testing and inspection bodies whose names can appear on quality and shipping documents.",
      note: "Each logo belongs to its organisation and is shown as a document issuer, not as certification or endorsement of Permata Briquettes. The issuer, date and scope are printed on each document.",
      list: "Laboratory and surveyor logos",
    };
---

{logos.length > 0 && (
  <Section labelledby={id}>
    <div class="partner-logos">
      <SectionHeader id={id} align="center" eyebrow={copy.eyebrow} title={copy.title} intro={copy.intro} />
      <ul class="logo-row" aria-label={copy.list}>
        {logos.map((logo) => (
          <li class="logo-tile">
            <Media id={logo.mediaId} locale={lang} sizes="9rem" class="logo-tile__media" />
          </li>
        ))}
      </ul>
      <p class="section-note">{copy.note}</p>
    </div>
  </Section>
)}
