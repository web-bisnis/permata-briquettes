---
import { hasMedia } from "../../config/media";
import type { MediaLocale } from "../../config/media-slots";
import Media from "../Media.astro";
import SectionHeader from "./SectionHeader.astro";

interface Member {
  name: string;
  role: string;
  photoId?: string;
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  linkLabel: string;
  href: string;
  lang: MediaLocale;
  members: readonly Member[];
}

const { id, eyebrow, title, body, linkLabel, href, lang, members } = Astro.props;
const portraits = members.filter((member) => hasMedia(member.photoId));
---

<section class="team-band" aria-labelledby={id}>
  <div class="container team-band__inner">
    <div class="team-band__text">
      <SectionHeader id={id} eyebrow={eyebrow} title={title} />
      <p>{body}</p>
      <ul class="team-band__names">
        {members.map((member) => (
          <li><strong>{member.name}</strong><span>{member.role}</span></li>
        ))}
      </ul>
      <a class="button button--secondary" href={href}>{linkLabel}</a>
    </div>
    {portraits.length > 0 && (
      <ul class="team-band__portraits">
        {portraits.map((member) => (
          <li>
            <Media
              id={member.photoId!}
              locale={lang}
              alt={member.name}
              ratio="9/16"
              sizes="(min-width: 48rem) 12vw, 30vw"
              class="team-band__media"
            />
          </li>
        ))}
      </ul>
    )}
  </div>
</section>
