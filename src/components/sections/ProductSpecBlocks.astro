---
import type { CollectionEntry } from "astro:content";
import type { MediaLocale } from "../../config/media-slots";
import GradeList from "./GradeList.astro";
import PageBlock from "./PageBlock.astro";
import ReferenceSpecs from "./ReferenceSpecs.astro";
import ShapeGallery from "./ShapeGallery.astro";
import SpecTable from "./SpecTable.astro";

interface Props {
  lang: MediaLocale;
  product: CollectionEntry<"products">["data"];
}

const { lang, product } = Astro.props;

const copy = lang === "id"
  ? {
      listTitle: "Pilihan grade",
      gradesTitle: "Perbandingan grade",
      shapesTitle: "Ukuran yang tercatat",
      shapesNote: "Ukuran khusus perlu disetujui per pesanan.",
      specsTitle: "Spesifikasi referensi",
    }
  : {
      listTitle: "Grade options",
      gradesTitle: "Grade comparison",
      shapesTitle: "Listed dimensions",
      shapesNote: "Custom sizes require case-by-case confirmation.",
      specsTitle: "Reference specifications",
    };
---

{product.grades && (
  <>
    <PageBlock id="grade-list" title={copy.listTitle}>
      <GradeList lang={lang} grades={product.grades} />
    </PageBlock>

    <PageBlock id="grade-comparison" title={copy.gradesTitle} note={product.referenceOnlyNotice}>
      <SpecTable lang={lang} grades={product.grades} />
    </PageBlock>
  </>
)}

{product.specs && (
  <PageBlock id="reference-specs" title={copy.specsTitle} note={product.referenceOnlyNotice}>
    <ReferenceSpecs lang={lang} specs={product.specs} />
  </PageBlock>
)}

<PageBlock id="listed-dimensions" title={copy.shapesTitle} note={copy.shapesNote}>
  <ShapeGallery lang={lang} shapes={product.shapes} />
</PageBlock>
