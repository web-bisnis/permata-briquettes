---
import { getNavigationItems } from "../config/navigation";
import { shouldShowBlogNav } from "../lib/blog";
import Logo from "./Logo.astro";

interface Props {
  lang: "en" | "id";
}

const { lang } = Astro.props;
const items = getNavigationItems(lang, await shouldShowBlogNav());
const footerCopy = lang === "id"
  ? "Permata Briquettes adalah merek dagang PT Permata Bara Globalindo. Briket arang tempurung kelapa untuk pembeli B2B."
  : "Permata Briquettes is the trading brand of PT Permata Bara Globalindo. Coconut charcoal briquettes for B2B buyers.";
const privacyLink = lang === "id"
  ? { href: "/id/privasi/", label: "Pemberitahuan Privasi" }
  : { href: "/en/privacy/", label: "Privacy Notice" };
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <Logo markOnly />
      <p>{footerCopy}</p>
    </div>
    <nav aria-label={lang === "id" ? "Navigasi footer" : "Footer navigation"}>
      <ul class="footer-navigation">
        {items.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
        <li><a href={privacyLink.href}>{privacyLink.label}</a></li>
      </ul>
    </nav>
  </div>
</footer>
