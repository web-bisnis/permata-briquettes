---
interface Props {
  labels?: {
    toDark: string;
    toLight: string;
  };
}

const { labels = {
  toDark: "Switch to dark theme",
  toLight: "Switch to light theme",
} } = Astro.props;
---

<!-- One toggle for two themes. The icon shows the current theme (CSS, from data-theme set before
     first paint); the accessible name describes the action and is kept in sync by the script. -->
<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  data-label-to-dark={labels.toDark}
  data-label-to-light={labels.toLight}
  aria-label={labels.toDark}
  title={labels.toDark}
>
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  if (toggle) {
    // Light is the default for every visitor; only an explicit choice is stored.
    const reflect = (theme: string) => {
      const label = theme === "dark" ? toggle.dataset.labelToLight : toggle.dataset.labelToDark;
      if (label) {
        toggle.setAttribute("aria-label", label);
        toggle.title = label;
      }
    };

    reflect(document.documentElement.dataset.theme === "dark" ? "dark" : "light");

    toggle.addEventListener("click", () => {
      const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";

      document.documentElement.dataset.theme = next;
      reflect(next);
      try {
        localStorage.setItem("theme", next);
      } catch {}
    });
  }
</script>
