---
import { navigationItems } from "../config/navigation";
import ThemeControl from "./ThemeControl.astro";

interface Props {
  lang: "en" | "id";
  alternateRoute: string;
}

const { lang, alternateRoute } = Astro.props;
const currentPath = Astro.url.pathname;
const homePath = lang === "id" ? "/id/" : "/en/";
const labels = lang === "id"
  ? {
      home: "Beranda Permata Briquettes",
      menu: "Menu",
      nav: "Navigasi utama",
      language: "EN",
      theme: { control: "Tema", system: "Sistem", light: "Terang", dark: "Gelap" },
    }
  : {
      home: "Permata Briquettes home",
      menu: "Menu",
      nav: "Main navigation",
      language: "ID",
      theme: { control: "Theme", system: "System", light: "Light", dark: "Dark" },
    };
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-home" href={homePath} aria-label={labels.home}>Permata Briquettes</a>

    <details class="site-navigation">
      <summary>{labels.menu}</summary>
      <div class="site-navigation__panel">
        <nav aria-label={labels.nav}>
          <ul class="site-navigation__list">
            {navigationItems[lang].map((item) => (
              <li>
                <a
                  class="site-navigation__link"
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a class="site-navigation__link" href={alternateRoute} hreflang={lang === "id" ? "en" : "id"}>
                {labels.language}
              </a>
            </li>
          </ul>
        </nav>
        <ThemeControl labels={labels.theme} />
      </div>
    </details>
  </div>
</header>
