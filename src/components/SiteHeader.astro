---
import { navigationItems } from "../config/navigation";
import FlagGb from "./FlagGb.astro";
import FlagId from "./FlagId.astro";
import Logo from "./Logo.astro";
import ThemeControl from "./ThemeControl.astro";

interface Props {
  lang: "en" | "id";
  alternateRoute: string;
}

const { lang, alternateRoute } = Astro.props;
const currentPath = Astro.url.pathname;
const homePath = lang === "id" ? "/id/" : "/en/";
const labels = lang === "id"
  ? {
      home: "Beranda Permata Briquettes",
      menu: "Menu",
      nav: "Navigasi utama",
      language: "Bahasa saat ini: Indonesia. Ganti ke English.",
      theme: { toDark: "Ganti ke tema gelap", toLight: "Ganti ke tema terang" },
    }
  : {
      home: "Permata Briquettes home",
      menu: "Menu",
      nav: "Main navigation",
      language: "Current language: English. Switch to Bahasa Indonesia.",
      theme: { toDark: "Switch to dark theme", toLight: "Switch to light theme" },
    };
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-home" href={homePath} aria-label={labels.home}><Logo showTagline /></a>

    <details class="site-navigation" data-site-navigation open>
      <summary aria-label={labels.menu}>
        <svg class="menu-icon" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false">
          <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="site-navigation__panel">
        <nav aria-label={labels.nav}>
          <ul class="site-navigation__list">
            {navigationItems[lang].map((item) => (
              <li>
                <a
                  class="site-navigation__link"
                  href={item.href}
                  aria-current={currentPath === item.href ? "page" : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            <li>
              <a
                class="site-navigation__link language-flag"
                href={alternateRoute}
                hreflang={lang === "id" ? "en" : "id"}
                aria-label={labels.language}
              >
                {lang === "id" ? <FlagId /> : <FlagGb />}
              </a>
            </li>
          </ul>
        </nav>
        <ThemeControl labels={labels.theme} />
      </div>
    </details>
  </div>
</header>

<script>
  const navigation = document.querySelector<HTMLDetailsElement>("[data-site-navigation]");
  const desktopNavigation = window.matchMedia("(min-width: 75rem)");

  if (navigation) {
    const synchronizeNavigation = () => {
      navigation.open = desktopNavigation.matches;
    };

    synchronizeNavigation();
    desktopNavigation.addEventListener("change", synchronizeNavigation);
  }
</script>
