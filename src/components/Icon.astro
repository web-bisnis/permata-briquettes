---
type IconName = "specs" | "quality" | "shipping" | "check" | "whatsapp";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg class:list={["icon", className]} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === "specs" && (
    <>
      <rect x="5" y="4" width="14" height="17" rx="2" />
      <path d="M9 4V3h6v1M9 11h6M9 15h6" />
    </>
  )}
  {name === "quality" && (
    <>
      <path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.500-7-10V6z" />
      <path d="M9 12l2 2 4-4" />
    </>
  )}
  {name === "shipping" && (
    <>
      <path d="M3 8l9-4 9 4v9l-9 4-9-4z" />
      <path d="M3 8l9 4 9-4M12 12v9" />
    </>
  )}
  {name === "whatsapp" && (
    <>
      <path d="M12 3a9 9 0 0 0-7.7 13.6L3 21l4.5-1.2A9 9 0 1 0 12 3z" />
      <path d="M9.200 8.200c-.6.700-.6 1.800.3 3.200 1 1.500 2.300 2.400 3.600 2.800.9.200 1.600-.4 1.900-1l-1.600-1-.9.700c-.9-.4-1.800-1.300-2.200-2.200l.7-.9-1-1.600z" />
    </>
  )}
  {name === "check" && <path d="M5 12.500l4.500 4.500L19 7.500" />}
</svg>
