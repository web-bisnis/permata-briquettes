---
import { Picture } from "astro:assets";
import CtaBand from "../../../components/sections/CtaBand.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { BLOG_COPY, blogFeedPath, blogListPath, formatBlogDate } from "../../../config/blog";
import { contactActions } from "../../../config/contact";
import { loadBlog, type BlogPost } from "../../../lib/blog";
import { secureExternalLinks } from "../../../lib/blog-html";

export async function getStaticPaths() {
  const { posts } = await loadBlog();
  return [...posts.en, ...posts.id].map((post) => ({
    params: { lang: post.locale, slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const lang = post.locale;
const copy = BLOG_COPY[lang];
const { data } = post.entry;
// The glob loader already rendered the Markdown; external links get their rel attribute here.
const html = post.entry.rendered?.html;
if (html === undefined) throw new Error(`Blog article ${post.entry.id} has no rendered HTML`);
const contactHref = lang === "id" ? "/id/kontak/" : "/en/contact/";
---

<BaseLayout
  title={data.title}
  description={data.description}
  lang={lang}
  route={post.route}
  alternateRoute={post.alternateRoute}
  indexable={!data.draft}
  socialImage={post.cover && data.coverAlt ? { source: post.cover, alt: data.coverAlt } : undefined}
  article={{ publishedAt: data.date }}
  feed={{ href: blogFeedPath(lang), title: copy.feed }}
>
  <article class="container content-page blog-article">
    <p><a class="blog-back" href={blogListPath(lang)}>{copy.back}</a></p>
    <header class="page-intro">
      <p class="blog-meta">
        <time datetime={data.date.toISOString().slice(0, 10)}>{copy.published} {formatBlogDate(data.date, lang)}</time>
        {data.draft && <span class="blog-badge">{copy.draftBadge}</span>}
      </p>
      <h1>{data.title}</h1>
      <p class="page-intro__summary">{data.description}</p>
      {data.tags.length > 0 && (
        <ul class="blog-tags" aria-label={copy.tags}>
          {data.tags.map((tag) => <li>{tag}</li>)}
        </ul>
      )}
    </header>

    {post.cover && data.coverAlt && (
      <figure class="blog-cover">
        <Picture
          src={post.cover}
          alt={data.coverAlt}
          formats={["avif", "webp"]}
          widths={[480, 768, 1200, 1600]}
          sizes="(min-width: 48rem) 48rem, 100vw"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </figure>
    )}

    <div class="prose">
      <Fragment set:html={secureExternalLinks(html)} />
    </div>

    <p><a class="blog-back" href={blogListPath(lang)}>{copy.back}</a></p>
  </article>

  <CtaBand
    id="blog-cta"
    title={copy.cta.title}
    body={copy.cta.body}
    actions={[
      { label: copy.cta.contact, href: contactHref, variant: "primary" },
      { ...contactActions(lang)[0], variant: "secondary" },
    ]}
  />
</BaseLayout>
