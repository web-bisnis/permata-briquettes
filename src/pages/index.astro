---
import PageSkeleton from "../components/PageSkeleton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const pageTitle = "Fondasi antarmuka";
const pageDescription = "Kerangka antarmuka statis untuk konten yang terverifikasi.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <PageSkeleton
    eyebrow="Kerangka halaman"
    title={pageTitle}
    summary="Sistem visual, tema, dan struktur global telah disiapkan tanpa menambahkan copy bisnis."
  />
</BaseLayout>
