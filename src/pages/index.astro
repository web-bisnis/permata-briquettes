---
import LanguageGatewayLayout from "../layouts/LanguageGatewayLayout.astro";
---

<LanguageGatewayLayout>
  <section class="container language-gateway" aria-labelledby="language-heading">
    <h1 id="language-heading">
      <span lang="en">Choose a language</span>
      <span aria-hidden="true"> / </span>
      <span lang="id">Pilih bahasa</span>
    </h1>

    <nav aria-label="Language / Bahasa">
      <ul class="language-options">
        <li><a href="/en/" lang="en" hreflang="en">English</a></li>
        <li><a href="/id/" lang="id" hreflang="id">Bahasa Indonesia</a></li>
      </ul>
    </nav>
  </section>
</LanguageGatewayLayout>
