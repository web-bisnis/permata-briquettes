---
import CloudflareWebAnalytics from "../components/CloudflareWebAnalytics.astro";
import SeoHead from "../components/SeoHead.astro";
import ThemeControl from "../components/ThemeControl.astro";
import { createRootSeo, resolveSiteEnvironment } from "../config/seo";
import "../styles/global.css";

const seo = createRootSeo(resolveSiteEnvironment(import.meta.env.SITE_ENV));
---

<!doctype html>
<html lang="mul">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <SeoHead seo={seo} />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("theme");
          if (savedTheme === "light" || savedTheme === "dark") {
            document.documentElement.dataset.theme = savedTheme;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content / Lewati ke konten</a>
    <header class="gateway-header">
      <div class="container gateway-header__inner">
        <ThemeControl
          labels={{
            control: "Theme / Tema",
            system: "System / Sistem",
            light: "Light / Terang",
            dark: "Dark / Gelap",
          }}
        />
      </div>
    </header>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <CloudflareWebAnalytics />
  </body>
</html>
