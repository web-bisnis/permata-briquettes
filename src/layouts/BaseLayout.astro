---
import CloudflareWebAnalytics from "../components/CloudflareWebAnalytics.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { resolveFaviconHref, resolveSocialImage } from "../config/media-seo";
import { registerPageCsp, THEME_BOOTSTRAP_SCRIPT } from "../config/security";
import {
  createLocalizedSeo,
  resolveCloudflareAnalytics,
  resolveSiteEnvironment,
} from "../config/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "en" | "id";
  route: string;
  alternateRoute: string;
  indexable: boolean;
  loadsTurnstile?: boolean;
  /** Slot id of the link-preview image; falls back to brand/og-default. */
  ogImage?: string;
}

const {
  title,
  description,
  lang,
  route,
  alternateRoute,
  indexable,
  loadsTurnstile = false,
  ogImage,
} = Astro.props;
const seo = createLocalizedSeo({
  title,
  description,
  locale: lang,
  route,
  alternateRoute,
  indexable,
  environment: resolveSiteEnvironment(import.meta.env.SITE_ENV),
  image: await resolveSocialImage(ogImage, lang),
});
const iconHref = await resolveFaviconHref();
registerPageCsp(Astro.csp, {
  analytics: resolveCloudflareAnalytics(import.meta.env).enabled,
  turnstile: loadsTurnstile,
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <SeoHead seo={seo} iconHref={iconHref} />
    <script is:inline set:html={THEME_BOOTSTRAP_SCRIPT}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {lang === "id" ? "Lewati ke konten utama" : "Skip to main content"}
    </a>
    <SiteHeader lang={lang} alternateRoute={alternateRoute} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <WhatsAppButton lang={lang} />
    <CloudflareWebAnalytics />
  </body>
</html>
