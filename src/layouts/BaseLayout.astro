---
import CloudflareWebAnalytics from "../components/CloudflareWebAnalytics.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { createLocalizedSeo, resolveSiteEnvironment } from "../config/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "en" | "id";
  route: string;
  alternateRoute: string;
  indexable: boolean;
}

const { title, description, lang, route, alternateRoute, indexable } = Astro.props;
const seo = createLocalizedSeo({
  title,
  description,
  locale: lang,
  route,
  alternateRoute,
  indexable,
  environment: resolveSiteEnvironment(import.meta.env.SITE_ENV),
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />
    <SeoHead seo={seo} />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem("theme");
          if (savedTheme === "light" || savedTheme === "dark") {
            document.documentElement.dataset.theme = savedTheme;
          }
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {lang === "id" ? "Lewati ke konten utama" : "Skip to main content"}
    </a>
    <SiteHeader lang={lang} alternateRoute={alternateRoute} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <CloudflareWebAnalytics />
  </body>
</html>
