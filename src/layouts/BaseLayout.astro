---
import CloudflareWebAnalytics from "../components/CloudflareWebAnalytics.astro";
import SeoHead from "../components/SeoHead.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import type { ImageMetadata } from "astro";
import { createArticleJsonLd, serializeJsonLd } from "../config/blog";
import { cropSocialImage, resolveFaviconHref, resolveSocialImage } from "../config/media-seo";
import { registerPageCsp, sha256Source, THEME_BOOTSTRAP_SCRIPT } from "../config/security";
import {
  createLocalizedSeo,
  resolveCloudflareAnalytics,
  resolveSiteEnvironment,
} from "../config/seo";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  lang: "en" | "id";
  route: string;
  alternateRoute: string;
  indexable: boolean;
  loadsTurnstile?: boolean;
  /** Slot id of the link-preview image; falls back to brand/og-default. */
  ogImage?: string;
  /** A picture that is not a media slot, such as a blog cover; wins over `ogImage`. */
  socialImage?: { source: ImageMetadata; alt: string };
  /** Marks the page as an article: og:type, publication date and JSON-LD. */
  article?: { publishedAt: Date };
  /** RSS feed advertised in <head>. */
  feed?: { href: string; title: string };
}

const {
  title,
  description,
  lang,
  route,
  alternateRoute,
  indexable,
  loadsTurnstile = false,
  ogImage,
  socialImage,
  article,
  feed,
} = Astro.props;
const seo = createLocalizedSeo({
  title,
  description,
  locale: lang,
  route,
  alternateRoute,
  indexable,
  environment: resolveSiteEnvironment(import.meta.env.SITE_ENV),
  image: socialImage
    ? await cropSocialImage(socialImage.source, socialImage.alt)
    : await resolveSocialImage(ogImage, lang),
});
// Inline scripts are not hashed by Astro, so the JSON-LD block is hashed here, before <head> renders.
const jsonLd = article
  ? serializeJsonLd(createArticleJsonLd({
      headline: title,
      description,
      datePublished: article.publishedAt,
      locale: lang,
      url: seo.canonical,
      imageUrl: seo.image?.url,
    }))
  : undefined;
const iconHref = await resolveFaviconHref();
registerPageCsp(Astro.csp, {
  analytics: resolveCloudflareAnalytics(import.meta.env).enabled,
  turnstile: loadsTurnstile,
  scriptHashes: jsonLd ? [await sha256Source(jsonLd)] : [],
});
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light" />
    <SeoHead
      seo={seo}
      iconHref={iconHref}
      ogType={article ? "article" : "website"}
      publishedTime={article?.publishedAt.toISOString()}
      feed={feed}
    />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLd}></script>}
    <script is:inline set:html={THEME_BOOTSTRAP_SCRIPT}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      {lang === "id" ? "Lewati ke konten utama" : "Skip to main content"}
    </a>
    <SiteHeader lang={lang} alternateRoute={alternateRoute} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <WhatsAppButton lang={lang} />
    <CloudflareWebAnalytics />
  </body>
</html>
