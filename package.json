{
  "name": "permata-briquettes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --noEmit -p worker/tsconfig.json",
    "build": "astro build",
    "audit:dist": "node scripts/audit-static-build.mjs --dir dist --environment local --analytics absent",
    "preview": "astro preview",
    "test": "vitest run",
    "worker:check": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrations:list:local": "wrangler d1 migrations list DB --local"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260930.2",
    "astro": "^7.3.5",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0"
  }
}
