{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "permata-briquettes-inquiry",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "INQUIRY_ENABLED": "false",
    "RUNTIME_MODE": "local",
    "USE_LOCAL_MOCKS": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "permata-briquettes-inquiry-local",
      "migrations_dir": "worker/migrations",
      "remote": false
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": false
  },
  "env": {
    "staging": {
      "name": "permata-briquettes-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "staging.permatabriquettes.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "INQUIRY_ENABLED": "false",
        "RUNTIME_MODE": "staging",
        "USE_LOCAL_MOCKS": "false",
        "PRIVACY_NOTICE_VERSION": "sha256-796520ac81b51f3b47e55d7b870a39d4443962c43da2495a487c087974f67878",
        "MARKETING_CONSENT_VERSION": "sha256-b7f8c726daf971743ef9295167b2852f98ef4495eb2399f30264ca02344909b3",
        "BUYER_CONFIRMATION_SUBJECT_EN": "Your inquiry has been received | Permata Briquettes",
        "BUYER_CONFIRMATION_TEXT_EN": "Thank you. We have received your inquiry. Our team will review it and aims to respond within one business day. For questions about personal data, please contact office@permatabriquettes.com.",
        "BUYER_CONFIRMATION_SUBJECT_ID": "Inquiry Anda telah diterima | Permata Briquettes",
        "BUYER_CONFIRMATION_TEXT_ID": "Terima kasih. Inquiry Anda telah kami terima. Tim kami akan meninjaunya dan berupaya merespons dalam satu hari kerja. Untuk pertanyaan terkait data pribadi, hubungi office@permatabriquettes.com."
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "permata-briquettes-staging",
          "migrations_dir": "worker/migrations"
        }
      ],
      "triggers": {
        "crons": []
      },
      "observability": {
        "enabled": false
      }
    },
    "production": {
      "name": "permata-briquettes-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "www.permatabriquettes.com",
          "custom_domain": true
        }
      ],
      "vars": {
        "INQUIRY_ENABLED": "false",
        "RUNTIME_MODE": "production",
        "USE_LOCAL_MOCKS": "false",
        "PRIVACY_NOTICE_VERSION": "sha256-796520ac81b51f3b47e55d7b870a39d4443962c43da2495a487c087974f67878",
        "MARKETING_CONSENT_VERSION": "sha256-b7f8c726daf971743ef9295167b2852f98ef4495eb2399f30264ca02344909b3",
        "BUYER_CONFIRMATION_SUBJECT_EN": "Your inquiry has been received | Permata Briquettes",
        "BUYER_CONFIRMATION_TEXT_EN": "Thank you. We have received your inquiry. Our team will review it and aims to respond within one business day. For questions about personal data, please contact office@permatabriquettes.com.",
        "BUYER_CONFIRMATION_SUBJECT_ID": "Inquiry Anda telah diterima | Permata Briquettes",
        "BUYER_CONFIRMATION_TEXT_ID": "Terima kasih. Inquiry Anda telah kami terima. Tim kami akan meninjaunya dan berupaya merespons dalam satu hari kerja. Untuk pertanyaan terkait data pribadi, hubungi office@permatabriquettes.com."
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "permata-briquettes-inquiry-production",
          "migrations_dir": "worker/migrations"
        }
      ],
      "triggers": {
        "crons": []
      },
      "observability": {
        "enabled": false
      }
    }
  }
}
