{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "permata-briquettes-inquiry",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "INQUIRY_ENABLED": "false",
    "RUNTIME_MODE": "local",
    "USE_LOCAL_MOCKS": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "permata-briquettes-inquiry-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "worker/migrations",
      "remote": false
    }
  ],
  "triggers": {
    "crons": []
  },
  "observability": {
    "enabled": false
  }
}
